<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.26100.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../windows/v60_viiper_app/Y700Switch2V60Viiper.csproj"/>
    <Compile Include="../../../windows/v60_viiper_app/Pro2LiveBatteryReadPolicy.cs"
             Link="ExperimentPolicies/Pro2LiveBatteryReadPolicy.cs"
             Condition="'$(BatteryReadExperiment)' != 'true'" />
  </ItemGroup>
</Project>
