<Window x:Class="XinHeLianSheng.ControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新和联胜三合一控制中心" Width="1260" Height="840"
        MinWidth="1040" MinHeight="700" WindowStartupLocation="CenterScreen"
        Background="#090C12" Foreground="#F3F6FF">
    <Window.Resources>
        <SolidColorBrush x:Key="MutedText" Color="#91A0B9" />
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F7FAFF" />
            <Setter Property="Background" Value="#1A2130" />
            <Setter Property="BorderBrush" Value="#33415E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RouteCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#121824" />
            <Setter Property="BorderBrush" Value="#263249" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="58" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0D121C" BorderBrush="#202A3D" BorderThickness="0,0,0,1">
            <Grid Margin="30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="新和联胜" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Text="PRO2 三合一控制中心 · Integration Test" Foreground="{StaticResource MutedText}"
                               FontSize="13" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" Background="#162335" CornerRadius="18" Padding="16,8"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="HeaderStatusDot" Width="9" Height="9" Fill="#55D6A5"
                                 VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="HeaderStatusText" Text="等待选择路线" Foreground="#CDE5DD" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="30,26,30,32">
                <TextBlock Text="选择你的连接路线" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="三套程序互相隔离，控制中心只允许一个后端处于活动状态，避免抢占 COM、BLE 或虚拟 USB。"
                           Foreground="{StaticResource MutedText}" FontSize="14" Margin="0,8,0,20" />

                <UniformGrid Columns="3" Rows="1">
                    <Button Style="{StaticResource RouteCard}" Click="SelectPico_Click" Margin="0,0,10,0">
                        <Grid Height="248">
                            <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#35D5A4" CornerRadius="10,10,0,0" />
                            <StackPanel Grid.Row="1" Margin="22,21">
                                <Grid Width="58" Height="58" HorizontalAlignment="Left">
                                    <Ellipse Fill="#173D38" />
                                    <Rectangle Width="24" Height="35" RadiusX="4" RadiusY="4" Fill="#58E5B7" />
                                    <Rectangle Width="12" Height="5" Fill="#0C2925" Margin="0,0,0,38" />
                                </Grid>
                                <TextBlock Text="Pico 2 W 背挂" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,5" />
                                <TextBlock Text="R40 候选固件" Foreground="#65E6BC" FontWeight="SemiBold" />
                                <TextBlock Text="轻量硬件方案，USB 读取 Pro2，蓝牙模拟四种手柄身份。"
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,13,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource RouteCard}" Click="SelectEsp_Click" Margin="5,0">
                        <Grid Height="248">
                            <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#FFB84D" CornerRadius="10,10,0,0" />
                            <StackPanel Grid.Row="1" Margin="22,21">
                                <Grid Width="58" Height="58" HorizontalAlignment="Left">
                                    <Ellipse Fill="#49351D" />
                                    <Rectangle Width="34" Height="28" RadiusX="4" RadiusY="4" Fill="#FFBF5B" />
                                    <Rectangle Width="17" Height="10" Fill="#1D2635" />
                                </Grid>
                                <TextBlock Text="ESP32-S3 接收板" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,5" />
                                <TextBlock Text="V5.9.19 候选" Foreground="#FFC76F" FontWeight="SemiBold" />
                                <TextBlock Text="刷写与检测中心，保留高回报率、HD 震动和硬件桥接上限。"
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,13,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                    <Button Style="{StaticResource RouteCard}" Click="SelectViiper_Click" Margin="10,0,0,0">
                        <Grid Height="248">
                            <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Border Background="#788BFF" CornerRadius="10,10,0,0" />
                            <StackPanel Grid.Row="1" Margin="22,21">
                                <Grid Width="58" Height="58" HorizontalAlignment="Left">
                                    <Ellipse Fill="#242C59" />
                                    <Path Fill="#94A3FF" Data="M 10,30 C 10,15 20,12 29,18 C 38,12 48,15 48,30 L 43,41 L 35,34 L 23,34 L 15,41 Z" />
                                    <Ellipse Width="5" Height="5" Fill="#11182B" Margin="-16,0,0,0" />
                                    <Ellipse Width="5" Height="5" Fill="#11182B" Margin="16,0,0,0" />
                                </Grid>
                                <TextBlock Text="纯软件直连" FontSize="20" FontWeight="SemiBold" Margin="0,16,0,5" />
                                <TextBlock Text="V6.2.32 Test R2" Foreground="#9EAAFF" FontWeight="SemiBold" />
                                <TextBlock Text="无需开发板，Windows BLE 直连 Pro2 并创建多模式虚拟手柄。"
                                           Foreground="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,13,0,0" />
                            </StackPanel>
                        </Grid>
                    </Button>
                </UniformGrid>

                <Border Background="#101722" BorderBrush="#27344C" BorderThickness="1" CornerRadius="14"
                        Margin="0,24,0,0" Padding="24">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,28,0">
                            <StackPanel Orientation="Horizontal">
                                <Border x:Name="SelectedBadge" Background="#174439" CornerRadius="12" Padding="10,5">
                                    <TextBlock x:Name="SelectedBadgeText" Text="轻量硬件" Foreground="#6AE9BD" />
                                </Border>
                                <TextBlock x:Name="SelectedVersionText" Text="R40 候选" Foreground="{StaticResource MutedText}"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                            <TextBlock x:Name="SelectedNameText" Text="Pico 2 W 一键刷机" FontSize="25"
                                       FontWeight="SemiBold" Margin="0,15,0,7" />
                            <TextBlock x:Name="SelectedDescriptionText" TextWrapping="Wrap" Foreground="#BAC5D9"
                                       FontSize="14" LineHeight="22" />
                            <ItemsControl x:Name="CapabilityList" Margin="0,15,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="0,4">
                                            <Ellipse Width="6" Height="6" Fill="#55D6A5" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding}" Foreground="#D8E0EE" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <Border Grid.Column="1" Background="#0B111A" CornerRadius="11" Padding="20">
                            <StackPanel>
                                <TextBlock Text="使用提示" FontWeight="SemiBold" Foreground="#F3F6FF" />
                                <TextBlock x:Name="SelectedGuidanceText" TextWrapping="Wrap" Foreground="{StaticResource MutedText}"
                                           LineHeight="21" Margin="0,8,0,18" />
                                <Button x:Name="LaunchButton" Content="打开当前路线" Click="Launch_Click"
                                        Background="#2B72FF" BorderBrush="#4E88FF" FontWeight="SemiBold" />
                                <Button x:Name="SwitchExperimentButton" Content="打开 Switch 1 实验入口"
                                        Click="LaunchSwitchExperiment_Click" Margin="0,9,0,0" Visibility="Collapsed"
                                        Background="#33291B" BorderBrush="#74562C" />
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <Button Content="打开日志" Click="OpenLogs_Click" Margin="0,0,5,0" />
                                    <Button Grid.Column="1" Content="结束当前后端" Click="StopBackend_Click" Margin="5,0,0,0" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Background="#0E141E" BorderBrush="#222D41" BorderThickness="1" CornerRadius="12"
                        Margin="0,18,0,0" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="控制中心状态" FontWeight="SemiBold" />
                            <TextBlock x:Name="OperationStatusText" Text="资源尚未解包；第一次打开某条路线时会进行 SHA256 校验。"
                                       Foreground="{StaticResource MutedText}" Margin="0,7,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="打开后端目录" Click="OpenBackendDirectory_Click"
                                Margin="20,0,0,0" VerticalAlignment="Center" />
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#0D121C" BorderBrush="#202A3D" BorderThickness="0,1,0,0">
            <Grid Margin="30,0">
                <TextBlock Text="集成测试版 · 后端保持独立 · 不会自动刷写或自动切换手柄模式"
                           Foreground="#74839C" VerticalAlignment="Center" />
                <TextBlock x:Name="FooterProcessText" Text="无活动后端" Foreground="#9EABBF"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
