<Window x:Class="Y700Switch2V55Manager.FirstRunGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新和联胜 ESP 首次运行向导"
        Width="980" Height="760" MinWidth="900" MinHeight="680"
        WindowStartupLocation="CenterOwner"
        Background="#F4F7FB"
        FontFamily="Segoe UI">
    <Window.Resources>
        <Style x:Key="GuideButton" TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="MinWidth" Value="110"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="GuidePrimaryButton" TargetType="Button" BasedOn="{StaticResource GuideButton}">
            <Setter Property="Background" Value="#0F766E"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#0F766E"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="GuideModeButton" TargetType="Button" BasedOn="{StaticResource GuideButton}">
            <Setter Property="MinWidth" Value="185"/>
            <Setter Property="MinHeight" Value="96"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="GuideHint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="LineHeight" Value="21"/>
        </Style>
        <Style x:Key="GuidePanel" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#D9E2EC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="24"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0F172A" Padding="26,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="ESP32-S3 首次运行向导" Foreground="#FFFFFF" FontSize="26" FontWeight="SemiBold"/>
                    <TextBlock x:Name="StepTitleText" Margin="0,6,0,0" Foreground="#BFD4F6" FontSize="14"/>
                </StackPanel>
                <Border Grid.Column="1" Background="#1E3A5F" BorderBrush="#60A5FA" BorderThickness="1"
                        CornerRadius="18" Padding="14,8" VerticalAlignment="Top">
                    <TextBlock x:Name="StepCounterText" Foreground="#FFFFFF" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="22">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid x:Name="ContentRoot">
                    <Border x:Name="Step0Panel" Style="{StaticResource GuidePanel}">
                        <StackPanel>
                            <TextBlock Text="先接好两根 USB 线" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Style="{StaticResource GuideHint}" Margin="0,8,0,0"
                                       Text="一根线负责刷写与 BLE 命令，另一根线负责让电脑识别虚拟手柄。首次刷写和首次配对期间两根都要保留。"/>

                            <Border Margin="0,20,0,18" Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1"
                                    CornerRadius="16" Padding="12">
                                <Canvas Height="245">
                                    <Border Canvas.Left="35" Canvas.Top="70" Width="170" Height="110" Background="#172554"
                                            BorderBrush="#60A5FA" BorderThickness="2" CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="Windows PC" Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold"/>
                                            <TextBlock Text="管理器 / Steam / joy.cpl" Foreground="#BFDBFE" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Canvas.Right="35" Canvas.Top="55" Width="205" Height="140" Background="#ECFDF5"
                                            BorderBrush="#10B981" BorderThickness="2" CornerRadius="12">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="ESP32-S3 控制板" Foreground="#064E3B" FontSize="19" FontWeight="SemiBold"/>
                                            <TextBlock Text="CH343 / COM 控制口" Foreground="#047857" Margin="0,10,0,0"/>
                                            <TextBlock Text="原生 USB / OTG 数据口" Foreground="#1D4ED8" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Line x:Name="ControlCable" X1="205" Y1="98" X2="713" Y2="98" Stroke="#F59E0B" StrokeThickness="7"/>
                                    <Line x:Name="DataCable" X1="205" Y1="154" X2="713" Y2="154" Stroke="#2563EB" StrokeThickness="7"/>
                                    <Border Canvas.Left="340" Canvas.Top="64" Background="#FFF7ED" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="控制线：刷机 + BLE 配对" Foreground="#9A3412" FontWeight="SemiBold"/>
                                    </Border>
                                    <Border Canvas.Left="340" Canvas.Top="166" Background="#EFF6FF" CornerRadius="10" Padding="10,5">
                                        <TextBlock Text="数据线：USB 手柄身份" Foreground="#1D4ED8" FontWeight="SemiBold"/>
                                    </Border>
                                </Canvas>
                            </Border>

                            <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="12" Padding="14">
                                <TextBlock Style="{StaticResource GuideHint}" Foreground="#9A3412"
                                           Text="不要把 Windows 的蓝牙虚拟串口当成控制板。正确候选通常包含 CH343、WCH 或 USB-Enhanced-SERIAL。"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step1Panel" Style="{StaticResource GuidePanel}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="识别 ESP 控制板" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Style="{StaticResource GuideHint}" Margin="0,8,0,16"
                                       Text="点击下面的按钮会刷新串口并检查原生 USB。刷写前必须先找到可用的 CH343/COM 控制口。"/>
                            <WrapPanel>
                                <Button x:Name="DetectBoardButton" Style="{StaticResource GuidePrimaryButton}" Content="检测 ESP 控制板" Click="Detect_Click"/>
                                <Button Style="{StaticResource GuideButton}" Content="修复 CH343 驱动" Click="Repair_Click"/>
                            </WrapPanel>
                            <Border x:Name="DetectionResultBorder" Margin="0,18,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="DetectionResultTitle" Text="等待检测" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock x:Name="DetectionResultText" Style="{StaticResource GuideHint}" Margin="0,7,0,0"
                                               Text="插好两根线后开始检测。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step2Panel" Style="{StaticResource GuidePanel}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="选择并刷入手柄模式" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Style="{StaticResource GuideHint}" Margin="0,8,0,16"
                                       Text="点击一个模式就会立即调用主程序的正式刷写流程。刷写失败时，这里会显示驱动、下载模式、串口占用或刷写器给出的具体理由。"/>
                            <UniformGrid Columns="2" Rows="2">
                                <Button Style="{StaticResource GuideModeButton}" Click="FlashPs5_Click">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="新和联胜 / PS5" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource GuideHint}" Margin="0,6,0,0" Text="054C:0CE6 · HD 震动 · PS5 IMU"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GuideModeButton}" Click="FlashPro2_Click">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Pro2 / Nintendo" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource GuideHint}" Margin="0,6,0,0" Text="057E:2069 · Steam 原生布局"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GuideModeButton}" Click="FlashXbox_Click">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="Xbox / XInput" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource GuideHint}" Margin="0,6,0,0" Text="045E:028E · 广泛兼容"/>
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource GuideModeButton}" Click="FlashEdge_Click">
                                    <StackPanel Margin="8">
                                        <TextBlock Text="新和联胜 / PS5 Edge" FontSize="18" FontWeight="SemiBold"/>
                                        <TextBlock Style="{StaticResource GuideHint}" Margin="0,6,0,0" Text="054C:0DF2 · 背键 · HD 震动"/>
                                    </StackPanel>
                                </Button>
                            </UniformGrid>
                            <Border x:Name="FlashResultBorder" Margin="0,16,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="FlashResultTitle" Text="尚未选择模式" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock x:Name="FlashResultText" Style="{StaticResource GuideHint}" Margin="0,7,0,0"
                                               Text="刷写期间不要拔掉 CH343/COM 控制线。"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step3Panel" Style="{StaticResource GuidePanel}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="验证 Windows 手柄身份" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock x:Name="ExpectedUsbText" Style="{StaticResource GuideHint}" Margin="0,8,0,16"/>
                            <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1" CornerRadius="12" Padding="14">
                                <TextBlock Style="{StaticResource GuideHint}" Foreground="#1E3A8A"
                                           Text="刷写完成后，只重新插拔原生 USB/OTG 数据线。CH343/COM 控制线先保留，配对步骤仍要使用。"/>
                            </Border>
                            <WrapPanel Margin="0,14,0,0">
                                <Button Style="{StaticResource GuidePrimaryButton}" Content="已重新插拔，检查身份" Click="Verify_Click"/>
                                <Button Style="{StaticResource GuideButton}" Content="打开 joy.cpl" Click="OpenJoy_Click"/>
                            </WrapPanel>
                            <Border x:Name="UsbResultBorder" Margin="0,16,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="UsbResultTitle" Text="等待 USB 检查" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock x:Name="UsbResultText" Style="{StaticResource GuideHint}" Margin="0,7,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step4Panel" Style="{StaticResource GuidePanel}" Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="配对真实 Pro2 手柄" FontSize="25" FontWeight="SemiBold" Foreground="#0F172A"/>
                            <TextBlock Style="{StaticResource GuideHint}" Margin="0,8,0,12"
                                       Text="只开启要绑定的那一只 Pro2，让它进入配对模式并靠近 ESP32-S3。自动配对会等待真实输入，而不只看 BLE 表面连接。"/>
                            <Button Style="{StaticResource GuidePrimaryButton}" HorizontalAlignment="Left"
                                    Content="开始自动配对" Click="AutoPair_Click"/>
                            <Border x:Name="PairResultBorder" Margin="0,14,0,0" Background="#F8FAFC" BorderBrush="#CBD5E1"
                                    BorderThickness="1" CornerRadius="12" Padding="16">
                                <StackPanel>
                                    <TextBlock x:Name="PairResultTitle" Text="等待配对" FontSize="17" FontWeight="SemiBold" Foreground="#334155"/>
                                    <TextBlock x:Name="PairResultText" Style="{StaticResource GuideHint}" Margin="0,7,0,0"
                                               Text="自动配对长时间失败后，向导会展开手动扫描。"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="ManualFallbackPanel" Margin="0,16,0,0" Background="#FFF7ED" BorderBrush="#FDBA74"
                                    BorderThickness="1" CornerRadius="12" Padding="16" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Text="手动扫描兜底" FontSize="17" FontWeight="SemiBold" Foreground="#9A3412"/>
                                    <TextBlock Style="{StaticResource GuideHint}" Foreground="#9A3412" Margin="0,6,0,10"
                                               Text="让 Pro2 保持配对灯闪烁，先扫描，再从列表里选择正确目标。"/>
                                    <WrapPanel>
                                        <Button Style="{StaticResource GuideButton}" Content="扫描 BLE" Click="Scan_Click"/>
                                        <ComboBox Width="430" Margin="8,5" Padding="8,6"
                                                  ItemsSource="{Binding BleDevices}"
                                                  SelectedItem="{Binding SelectedBleDevice, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName"/>
                                        <Button Style="{StaticResource GuidePrimaryButton}" Content="连接所选" Click="Connect_Click"/>
                                    </WrapPanel>
                                    <TextBlock x:Name="ManualResultText" Style="{StaticResource GuideHint}" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="Step5Panel" Style="{StaticResource GuidePanel}" Visibility="Collapsed">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="650">
                            <Border x:Name="SuccessBadge" Width="130" Height="130" CornerRadius="65" Background="#DCFCE7"
                                    BorderBrush="#22C55E" BorderThickness="3" RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="SuccessScale" ScaleX="0.7" ScaleY="0.7"/>
                                </Border.RenderTransform>
                                <Path Data="M 33,68 L 56,91 L 100,43" Stroke="#16A34A" StrokeThickness="10"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Border>
                            <TextBlock Text="刷写与配对完成" FontSize="28" FontWeight="SemiBold" Foreground="#0F172A"
                                       HorizontalAlignment="Center" Margin="0,18,0,0"/>
                            <TextBlock Style="{StaticResource GuideHint}" TextAlignment="Center" Margin="0,10,0,0"
                                       Text="Windows 已识别目标手柄，ESP 也已保存真实 Pro2 地址。以后手柄唤醒后，固件会优先自动重连。"/>
                            <Border Margin="0,20,0,0" Background="#EFF6FF" BorderBrush="#60A5FA" BorderThickness="1"
                                    CornerRadius="14" Padding="18">
                                <TextBlock TextAlignment="Center" TextWrapping="Wrap" Foreground="#1E3A8A" FontSize="16" FontWeight="SemiBold"
                                           Text="现在可以拔掉 CH343/COM 控制线，只保留原生 USB/OTG 数据线。需要改模式、重刷或手动管理 BLE 时再接回控制线。"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <Border x:Name="OperationOverlay" Background="#CCFFFFFF" CornerRadius="18" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="430">
                    <ProgressBar Height="8" IsIndeterminate="True"/>
                    <TextBlock x:Name="OperationText" Margin="0,16,0,0" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="#0F172A" FontSize="16" FontWeight="SemiBold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#FFFFFF" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource GuideButton}" Content="关闭向导" Click="Close_Click"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button x:Name="BackButton" Style="{StaticResource GuideButton}" Content="上一步" Click="Back_Click"/>
                    <Button x:Name="NextButton" Style="{StaticResource GuidePrimaryButton}" Content="下一步" Click="Next_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
