<Window x:Class="Y700Switch2V60Viiper.EnvironmentInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="系统与蓝牙信息" Width="800" Height="640" MinWidth="440" MinHeight="340"
        WindowStartupLocation="CenterOwner" Background="#F5F7F6" Foreground="#192824"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE7E2"/>
            <Setter Property="Foreground" Value="#253C32"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="系统与蓝牙信息" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="设备信息自动记录到启动日志；这里可直接复制或保存。" Foreground="#667870" Margin="0,8,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="{Binding EnvironmentInfoStatus}" Foreground="#315847" Margin="0,16,0,12" TextWrapping="Wrap"/>
        <Border Grid.Row="2" Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="12" Padding="14">
            <TextBox x:Name="EnvironmentReportBox" Text="{Binding EnvironmentReportText, Mode=OneWay}"
                     AutomationProperties.Name="系统与蓝牙详细信息" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                     Background="Transparent" BorderThickness="0" FontSize="12"/>
        </Border>
        <WrapPanel Grid.Row="3" Margin="0,16,0,0">
            <Button x:Name="RefreshInfoButton" Content="重新读取" Click="Refresh_Click">
                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Style.Triggers><DataTrigger Binding="{Binding EnvironmentInfoBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers>
                </Style></Button.Style>
            </Button>
            <Button Content="复制全部信息" Click="Copy_Click"/>
            <Button Content="保存信息…" Click="Save_Click"/>
            <Button Content="返回" Click="Return_Click"/>
        </WrapPanel>
    </Grid>
</Window>
