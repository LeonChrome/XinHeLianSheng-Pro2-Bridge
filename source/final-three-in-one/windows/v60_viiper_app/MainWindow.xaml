                        <Button Grid.Column="1" Margin="26,0"
                                MinWidth="320"
                                Style="{StaticResource EnterButton}"
                                Command="{Binding ConnectPro2InputCommand}"
                                IsEnabled="{Binding CanOperate}"
                                automation:AutomationProperties.Name="连接 Pro2 BLE"
                                Content="{Binding BleButtonText}"/>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Right" Style="{StaticResource SectionLabel}" Text="MISSION STATUS"/>
                            <TextBlock HorizontalAlignment="Right" Margin="0,5,0,0" FontSize="13" FontWeight="Bold"
                                       Foreground="#E4EAFE" Text="{Binding SelectedModeLabel}"/>
                            <TextBlock HorizontalAlignment="Right" Margin="0,4,0,0" Width="430" Height="42" FontSize="11"
                                       Foreground="#8390AE" Text="{Binding Status}" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Expander Grid.Row="4"
                          automation:AutomationProperties.Name="系统控制台"
                          IsExpanded="False"
                          Foreground="#E9EEFF">
                    <Expander.Header>
                        <Border Padding="15,10" CornerRadius="11" Background="#141C31" BorderBrush="#33415F" BorderThickness="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontWeight="Bold" Text="系统控制台"/>
                                <TextBlock Margin="12,0,0,0" Foreground="#71809F"
                                           Text="VIIPER · USBIP · BLE SCAN · DIAGNOSTICS"/>
                            </StackPanel>
                        </Border>
                    </Expander.Header>
                    <Border Margin="0,10,0,0" Padding="18" CornerRadius="16"
                            Background="{StaticResource ConsoleBackground}"
                            BorderBrush="#2B3855" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="310"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="350"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Style="{StaticResource SectionLabel}" Text="VIIPER SERVER"/>
                                <TextBlock Margin="0,9,0,3" Foreground="#A7B3CE" Text="Host"/>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         automation:AutomationProperties.Name="VIIPER Host"
                                         Text="{Binding Host, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanManageRuntime}"/>
                                <TextBlock Margin="0,9,0,3" Foreground="#A7B3CE" Text="Port"/>
                                <TextBox Style="{StaticResource DarkTextBox}"
                                         automation:AutomationProperties.Name="VIIPER Port"
                                         Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CanManageRuntime}"/>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="安装/修复 USBIP"
                                            Command="{Binding InstallUsbipCommand}"
                                            IsEnabled="{Binding CanManageRuntime}"/>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="启动本地 VIIPER"
                                            automation:AutomationProperties.Name="启动本地 VIIPER"
                                            Command="{Binding StartViiperServerCommand}"
                                            IsEnabled="{Binding CanManageRuntime}"/>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="Ping VIIPER"
                                            automation:AutomationProperties.Name="Ping VIIPER"
                                            Command="{Binding PingCommand}"
                                            IsEnabled="{Binding CanOperate}"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Style="{StaticResource SectionLabel}" Text="PRO2 BLE CONTROL"/>
                                <TextBlock Margin="0,9,0,12" Foreground="#A7B3CE" Text="{Binding InputStatus}" TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="扫描 Pro2 BLE"
                                            automation:AutomationProperties.Name="扫描 Pro2 BLE"
                                            Command="{Binding ScanPro2InputCommand}"
                                            IsEnabled="{Binding CanManualBleControl}"/>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="启动自动连接"
                                            Command="{Binding ConnectPro2InputCommand}"
                                            IsEnabled="{Binding CanOperate}"/>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="停止自动重连并断开"
                                            automation:AutomationProperties.Name="停止自动重连并断开"
                                            Command="{Binding DisconnectPro2InputCommand}"
                                            IsEnabled="{Binding CanOperate}"/>
                                    <Button Style="{StaticResource ConsoleButton}"
                                            Content="陀螺仪静置校准 3 秒"
                                            automation:AutomationProperties.Name="校准真实 Pro2 陀螺仪零偏"
                                            Command="{Binding CalibrateSourceGyroCommand}"
                                            IsEnabled="{Binding CanOperate}"
                                            ToolTip="手柄放在稳定平面后点击。只减去实测零偏，不使用死区或滤波。"/>
                                </WrapPanel>
                                <Border Margin="0,12,0,0" Padding="12" CornerRadius="10" Background="#111A2E" BorderBrush="#263655" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionLabel}" Text="4 PLAYER SLOT"/>
                                        <TextBlock Margin="0,6,0,9"
                                                   Foreground="#7D8DAD"
                                                   FontSize="10"
                                                   TextWrapping="Wrap"
                                                   Text="四个正式模式均生效：新和联胜 PS5、PS5 Edge、Pro2 / Nintendo、Xbox。每个 Slot 独立连接、独立震动，并按真实手柄 BLE 地址保存摇杆校准。建议先做零位，再做完整行程。"/>
                                        <ItemsControl ItemsSource="{Binding Pro2Slots}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="0,0,0,8" Padding="10" CornerRadius="9" Background="#17213A">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <CheckBox DockPanel.Dock="Left"
                                                                          Foreground="#E4EAFE"
                                                                          IsChecked="{Binding Enabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                          Content="{Binding Headline}"/>
                                                            </DockPanel>
                                                            <TextBlock Margin="0,6,0,8"
                                                                       Foreground="#8EA0C0"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding Status}"/>
                                                            <TextBlock Margin="0,0,0,8"
                                                                       Foreground="#72D7B0"
                                                                       FontSize="10"
                                                                       TextWrapping="Wrap"
                                                                       Text="{Binding StickCalibrationStatus}"/>
                                                            <WrapPanel>
                                                                <Button Style="{StaticResource ConsoleButton}"
                                                                        MinWidth="58"
                                                                        Padding="7,3"
                                                                        Content="扫描"
                                                                        Command="{Binding DataContext.ScanPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Button Style="{StaticResource ConsoleButton}"
                                                                        MinWidth="58"
                                                                        Padding="7,3"
                                                                        Content="连接"
                                                                        Command="{Binding DataContext.ConnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Button Style="{StaticResource ConsoleButton}"
                                                                        MinWidth="58"
                                                                        Padding="7,3"
                                                                        Content="断开"
                                                                        Command="{Binding DataContext.DisconnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Button Style="{StaticResource ConsoleButton}"
                                                                        MinWidth="82"
                                                                        Padding="7,3"
                                                                        Content="零位 2 秒"
                                                                        ToolTip="完全松开左右摇杆并保持两秒。只校准中心，不修改端点。"
                                                                        Command="{Binding DataContext.CalibrateStickCenterSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                                <Button Style="{StaticResource ConsoleButton}"
                                                                        MinWidth="108"
                                                                        Padding="7,3"
                                                                        Content="完整行程 8 秒"
                                                                        ToolTip="先完成零位校准，再把左右摇杆贴着外圈各转满至少三圈。四轴八方向独立保存。"
                                                                        Command="{Binding DataContext.CalibrateStickRangeSlotCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        IsEnabled="{Binding DataContext.CanOperate, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,12,0,0" Padding="12" CornerRadius="10" Background="#171F35">
                                    <StackPanel>
                                        <TextBlock Foreground="#93A1BF" Text="{Binding Status}" TextWrapping="Wrap"/>
                                        <TextBlock Margin="0,7,0,0" Foreground="#6F80A2" FontSize="10"
                                                   Text="正常使用无需操作本区域。进入游戏后会持续扫描、自动连接，并在断联后自动恢复。"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Column="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="220"/>
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource SectionLabel}" Text="LIVE DIAGNOSTICS"/>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Style="{StaticResource ConsoleButton}"
                                                MinWidth="108" Padding="8,4"
                                                Content="设备枚举"
                                                Command="{Binding DumpControllerEnumerationCommand}"
                                                IsEnabled="{Binding CanOperate}"
                                                ToolTip="Dump VIIPER bus、usbip port 和 Windows PnP/HID 字段。"/>
                                        <Button Style="{StaticResource ConsoleButton}"
                                                MinWidth="128" Padding="8,4"
                                                Content="清理残留虚拟"
                                                Command="{Binding CleanupStaleVirtualDevicesCommand}"
                                                IsEnabled="{Binding CanOperate}"
                                                ToolTip="停止当前会话，先正常 detach USBIP，再清理本地 VIIPER device/bus。"/>
                                        <Button Style="{StaticResource ConsoleButton}"
                                                MinWidth="128" Padding="8,4"
                                                Content="刷新 Steam 缓存"
                                                Click="RefreshSteamControllerCache_Click"
                                                IsEnabled="{Binding CanOperate}"
                                                ToolTip="会先正常拔出虚拟手柄，再请求 Steam 正常退出并重新打开；不会强制结束 Steam。"/>
                                        <Button Style="{StaticResource ConsoleButton}"
                                                MinWidth="96" Padding="8,4"
                                                Content="导出诊断"
                                                Command="{Binding ExportDiagnosticsLogCommand}"
                                                IsEnabled="{Binding CanOperate}"/>
                                        <Button Style="{StaticResource ConsoleButton}"
                                                MinWidth="70" Padding="8,4"
                                                Content="清空"
                                                Command="{Binding ClearLogCommand}"/>
                                    </WrapPanel>
                                </DockPanel>
                                <TextBox Grid.Row="1"
                                         Margin="0,9,0,0"
                                         Style="{StaticResource DarkTextBox}"
                                         automation:AutomationProperties.Name="实时日志"
                                         Text="{Binding LogText, Mode=OneWay}"
                                         FontFamily="Consolas"
                                         FontSize="11"
                                         IsReadOnly="True"
                                         IsUndoEnabled="False"
                                         TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Auto"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>


