<Window x:Class="Y700Switch2V60Viiper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Y700Switch2V60Viiper"
        Title="PRO2 手柄助手" Width="1040" Height="820" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F5F7F6"
        Foreground="#192824" FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
        <local:RearKeyColumnsConverter x:Key="RearColumns"/>
        <SolidColorBrush x:Key="Muted" Color="#667870"/>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="FontWeight" Value="Normal"/></Style>
        <Style x:Key="MutedText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DFE7E2"/>
            <Setter Property="Foreground" Value="#253C32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.82"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#468872"/></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonBorder" Property="Opacity" Value="0.38"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#183D31"/>
            <Setter Property="BorderBrush" Value="#183D31"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E9E4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>
        <Style x:Key="ModeCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="18,20"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Foreground" Value="#667870"/>
            <Setter Property="Template">
                <Setter.Value><ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder" CornerRadius="8" Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter ContentSource="Header"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="#183D31"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter TargetName="TabBorder" Property="Background" Value="#E7EDE8"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="#468872"/><Setter TargetName="TabBorder" Property="BorderThickness" Value="1"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Margin" Value="0,10,0,10"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,6,0,12"/></Style>
        <Style x:Key="NumberInput" TargetType="TextBox">
            <Setter Property="Padding" Value="9,7"/><Setter Property="Margin" Value="0,7,12,0"/>
            <Setter Property="BorderBrush" Value="#DFE7E2"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="RearChoice" TargetType="CheckBox">
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
                <Border x:Name="KeyBorder" CornerRadius="8" Background="#F6F8F7" BorderBrush="#DFE7E2" BorderThickness="1" Padding="8,9">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="KeyBorder" Property="Background" Value="#E4F0E8"/><Setter TargetName="KeyBorder" Property="BorderBrush" Value="#699980"/><Setter Property="Foreground" Value="#183D31"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="#699980"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="KeyBorder" Property="BorderBrush" Value="#183D31"/><Setter TargetName="KeyBorder" Property="BorderThickness" Value="2"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate DataType="{x:Type local:RearButtonEditor}">
            <Border Style="{StaticResource Card}" Padding="20" Margin="0">
                <StackPanel>
                    <DockPanel>
                        <CheckBox Content="启用映射" IsChecked="{Binding Enabled}" DockPanel.Dock="Right" Margin="12,0,0,0"/>
                        <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold"/>
                    </DockPanel>
                    <StackPanel Margin="0,16,0,0">
                        <DockPanel>
                            <ComboBox ItemsSource="{x:Static local:RearButtonEditor.Actions}" SelectedItem="{Binding Action}" Width="160" DockPanel.Dock="Right" Margin="12,0,0,12"/>
                            <StackPanel VerticalAlignment="Center"><TextBlock Text="输出按键" FontWeight="SemiBold"/><TextBlock Text="{Binding MappingSummary}" Style="{StaticResource MutedText}" Margin="0,4,0,10"/></StackPanel>
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Buttons}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource RearColumns}}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <CheckBox Content="{Binding Label}" IsChecked="{Binding Selected}" Style="{StaticResource RearChoice}"/>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <UniformGrid Columns="4" Margin="0,12,0,0">
                            <StackPanel><TextBlock Text="延迟（ms）" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" ToolTip="0–30000ms"/></StackPanel>
                            <StackPanel Visibility="{Binding IsTimed, Converter={StaticResource BoolVisibility}}"><TextBlock Text="按下时长（ms）" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" ToolTip="30–30000ms"/></StackPanel>
                            <StackPanel Visibility="{Binding IsRepeat, Converter={StaticResource BoolVisibility}}"><TextBlock Text="松开间隔（ms）" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Gap, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" ToolTip="30–30000ms"/></StackPanel>
                            <StackPanel Visibility="{Binding IsRepeat, Converter={StaticResource BoolVisibility}}"><TextBlock Text="次数（0=按住）" Style="{StaticResource MutedText}"/>
                                <TextBox Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" ToolTip="0=按住持续连发；1–1000=最多次数"/></StackPanel>
                        </UniformGrid>
                        <TextBlock Text="{Binding BehaviorHint}" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                        <StackPanel Visibility="{Binding IsSequence, Converter={StaticResource BoolVisibility}}" Margin="0,18,0,0">
                            <TextBlock Text="后续按键" FontWeight="SemiBold" Margin="0,0,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                <TextBlock Text="按键 1" Style="{StaticResource MutedText}"/>
                                <TextBlock Grid.Column="1" Text="组合按键 2" Style="{StaticResource MutedText}"/>
                                <TextBlock Grid.Column="2" Text="延迟 ms" Style="{StaticResource MutedText}"/>
                                <TextBlock Grid.Column="3" Text="时长 ms" Style="{StaticResource MutedText}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Steps}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="90"/><ColumnDefinition Width="38"/></Grid.ColumnDefinitions>
                                        <ComboBox ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding First}" Margin="0,7,10,7"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Choices}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Second}" Margin="0,7,10,7"/>
                                        <TextBox Grid.Column="2" Text="{Binding Delay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" Margin="0,7,10,7"/>
                                        <TextBox Grid.Column="3" Text="{Binding Duration, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumberInput}" Margin="0,7,10,7"/>
                                        <Button Grid.Column="4" Content="×" Command="{Binding RemoveCommand}" Padding="9,4" Margin="0,7,0,7" ToolTip="删除"/>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="+ 添加按键" Command="{Binding AddStepCommand}" HorizontalAlignment="Left" Margin="0,10,0,0" ToolTip="最多16个后续按键"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="28,22,28,16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Background="#183D31" CornerRadius="10" Width="36" Height="36" Margin="0,0,12,0">
                    <TextBlock Text="P" Foreground="White" FontWeight="Bold" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="PRO2 手柄助手" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="16" Background="#E7EDE8" Padding="13,7" VerticalAlignment="Center">
                <TextBlock Text="{Binding CompactStateText}" FontSize="12" Foreground="#315847"/>
            </Border>
        </Grid>
        <TabControl x:Name="MainTabs" Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0,18,0,0">
            <TabItem Header="手柄" AutomationProperties.Name="手柄">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ScrollViewer x:Name="HomeScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,4,0">
                        <Border>
                            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Card}"><Style.Triggers>
                                <DataTrigger Binding="{Binding HasLowRateWarning}" Value="True"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></DataTrigger>
                                <DataTrigger Binding="{Binding ShowWin10BleHomePanel}" Value="True"><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/></DataTrigger>
                            </Style.Triggers></Style></Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                                    <TextBlock Text="PURE SOFTWARE / 纯软件连接" FontSize="10" Foreground="#789180" Margin="0,0,0,10">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLowRateWarning}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ShowWin10BleHomePanel}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                        </Style.Triggers></Style></TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock x:Name="BleConnectionTitleText" Text="{Binding BleConnectionTitle}" FontSize="25" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="BleConnectionHintText" Text="{Binding BleConnectionHint}" Foreground="{StaticResource Muted}" Margin="0,12,0,0" LineHeight="21"/>
                                </StackPanel>
                                <local:Pro2Illustration Grid.Column="1" Width="160" VerticalAlignment="Center">
                                    <local:Pro2Illustration.Style><Style TargetType="local:Pro2Illustration"><Setter Property="Height" Value="112"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasLowRateWarning}" Value="True"><Setter Property="Height" Value="64"/></DataTrigger>
                                            <DataTrigger Binding="{Binding ShowWin10BleHomePanel}" Value="True"><Setter Property="Height" Value="64"/></DataTrigger>
                                        </Style.Triggers>
                                    </Style></local:Pro2Illustration.Style>
                                </local:Pro2Illustration>
                            </Grid>
                        </Border>
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="真实 FD2 输入" Style="{StaticResource MutedText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0"><TextBlock Text="{Binding CompactInputRate}" FontSize="26" FontWeight="SemiBold"/><TextBlock Text=" Hz" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="0,0,0,4"/></StackPanel>
                                <TextBlock Text="{Binding BleStabilitySummary}" ToolTip="{Binding BleOptimizationSummary}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,3,8,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" ToolTip="{Binding CompactBatteryHint}" Margin="0,0,12,0">
                                <TextBlock Text="手柄电量" Style="{StaticResource MutedText}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,9,0,0" VerticalAlignment="Center">
                                    <Border BorderBrush="#90A99A" BorderThickness="1.2" CornerRadius="4" Padding="3" VerticalAlignment="Center">
                                        <ItemsControl ItemsSource="{Binding CompactBatteryVisual.Segments}" AutomationProperties.Name="九格电量（连接时读取）">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate><DataTemplate><Border Width="6" Height="15" CornerRadius="1.5" Background="{Binding Fill}" Margin="0,0,2,0"/></DataTemplate></ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                    <Border Width="3" Height="9" CornerRadius="0,2,2,0" Background="#90A99A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding CompactBatteryVisual.Level}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding CompactBatteryVisual.Caption}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
                                <TextBlock Text="{Binding CompactBatteryVisual.Charge}" FontSize="11" Foreground="#40866A"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="手柄信息" Style="{StaticResource MutedText}"/>
                                <DockPanel Margin="0,8,0,0" ToolTip="{Binding CompactFirmwareHint}"><TextBlock Text="固件" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Text="{Binding CompactFirmware}" FontWeight="SemiBold"/></DockPanel>
                                <DockPanel Margin="0,6,0,0" ToolTip="仅显示实体耳机孔的插入状态，音频传输尚未启用"><TextBlock Text="耳机孔" Foreground="{StaticResource Muted}" Margin="0,0,12,0"/><TextBlock Text="{Binding CompactHeadset}" FontWeight="SemiBold"/></DockPanel>
                            </StackPanel>
                        </Grid>
                        <Border x:Name="LowRateNotice" Visibility="{Binding HasLowRateWarning, Converter={StaticResource BoolVisibility}}"
                                Background="#FFF9ED" BorderBrush="#E9D7AF" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="{Binding LowRateTitle}" Foreground="#765C24" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="BleOptimizationSummaryText" Text="{Binding BleOptimizationSummary}" Visibility="{Binding ShowBleOptimizationSummary, Converter={StaticResource BoolVisibility}}"
                                           Foreground="#765C24" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LowRateMeasuredSummary}" Foreground="#765C24" FontSize="12" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding LowRateEnvironmentSummary}" Foreground="#806C43" FontSize="11" Margin="0,3,0,0"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding EnvironmentHomeSummaryHint}"/>
                                <TextBlock Text="{Binding LowRateSummary}" Foreground="#806C43" FontSize="12" Margin="0,5,0,0"/>
                                <Expander Header="原因待定位 · 依据、建议与导出" FontSize="12" Foreground="#806C43" Margin="0,6,0,0">
                                    <StackPanel Margin="0,8,0,0">
                                        <TextBlock Text="{Binding LowRateAdvice}" Foreground="#806C43" FontSize="12"/>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Content="复制诊断" Click="CopyLowRateDiagnosis_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"/>
                                            <Button Content="信息 / 导出…" Click="EnvironmentInfo_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"/>
                                            <Button x:Name="BleAutoOptimizeButton" Content="自动优化蓝牙…" Click="TryWin11Compatibility_Click" Padding="10,5" Margin="0,0,8,4" FontSize="12"
                                                    IsEnabled="{Binding CanTryWin11Compatibility}" Visibility="{Binding ShowWin11CompatibilityAction, Converter={StaticResource BoolVisibility}}"/>
                                        </WrapPanel>
                                        <TextBox Text="{Binding LowRateEvidence, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" Height="140"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,8,0,0"
                                                 BorderThickness="0" Background="Transparent" FontSize="11"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <TextBlock Text="以哪种手柄身份游玩？" FontWeight="SemiBold" Margin="0,0,0,12"/>
                        <Grid IsEnabled="{Binding CanOperate}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Button Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro2" AutomationProperties.Name="Steam / Pro2 模式">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeCard}"><Style.Triggers><DataTrigger Binding="{Binding IsPro2Selected}" Value="True"><Setter Property="Background" Value="#EAF2EC"/><Setter Property="BorderBrush" Value="#699980"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel><TextBlock Text="Steam / Pro2" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Steam Input · 陀螺仪" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Column="1" Command="{Binding SelectCompactModeCommand}" CommandParameter="Pro1" AutomationProperties.Name="Pro1 模式">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeCard}"><Style.Triggers><DataTrigger Binding="{Binding IsPro1Selected}" Value="True"><Setter Property="Background" Value="#EAF2EC"/><Setter Property="BorderBrush" Value="#699980"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel><TextBlock Text="Pro1" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="经典兼容 · 软件背键" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Column="2" Command="{Binding SelectCompactModeCommand}" CommandParameter="Xbox" AutomationProperties.Name="Xbox 模式">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeCard}"><Style.Triggers><DataTrigger Binding="{Binding IsXboxSelected}" Value="True"><Setter Property="Background" Value="#EAF2EC"/><Setter Property="BorderBrush" Value="#699980"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel><TextBlock Text="Xbox" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="广泛兼容 · 普通震动" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                            <Button Grid.Column="3" Command="{Binding SelectCompactModeCommand}" CommandParameter="PS5" Margin="0,0,0,8" AutomationProperties.Name="PS5 模式">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource ModeCard}"><Style.Triggers><DataTrigger Binding="{Binding CompactPs5Selected}" Value="True"><Setter Property="Background" Value="#EAF2EC"/><Setter Property="BorderBrush" Value="#699980"/></DataTrigger></Style.Triggers></Style></Button.Style>
                                <StackPanel><TextBlock Text="PS5" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="触觉转换 · 陀螺仪" Style="{StaticResource MutedText}" Margin="0,7,0,0"/></StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
                        <StackPanel Grid.Row="1" Margin="0,14,0,0">
                        <WrapPanel>
                            <Button Content="{Binding CompactConnectText}" Command="{Binding ConnectPro2InputCommand}" Style="{StaticResource Primary}" IsEnabled="{Binding CompactCanConnect}" HorizontalAlignment="Left" MinWidth="150"/>
                            <Button Content="手动模式（不推荐）" Click="ManualConnect_Click" IsEnabled="{Binding CanOperate}"/>
                            <Button Content="停止 / 暂停重连" Command="{Binding CompactStopCommand}" IsEnabled="{Binding CompactCanStop}"/>
                            <Button x:Name="Win10BleOptimizeButton" Content="优化蓝牙 · Win10" Click="ToggleWin10BleHomePanel_Click"
                                    IsEnabled="{Binding CanOperate}" Visibility="{Binding ShowWin10BleHomeAction, Converter={StaticResource BoolVisibility}}"
                                    ToolTip="选择 7.5ms 参数并授权测试"/>
                            <Button Content="取消操作" Command="{Binding CancelConnectionCommand}" Visibility="{Binding Busy, Converter={StaticResource BoolVisibility}}"/>
                        </WrapPanel>
                        <Border x:Name="Win10BleHomePanel" Visibility="{Binding ShowWin10BleHomePanel, Converter={StaticResource BoolVisibility}}"
                                Background="White" BorderBrush="#DFE7E2" BorderThickness="1" CornerRadius="10" Padding="14,12" Margin="0,4,4,0">
                            <StackPanel IsEnabled="{Binding CanOperate}">
                                <TextBlock Text="Win10 蓝牙优化" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Win10BleHomeHint}" Style="{StaticResource MutedText}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ComboBox x:Name="Win10BlePresetComboBox" Width="145" ItemsSource="{Binding Win10BlePresetOptions}" SelectedItem="{Binding SelectedWin10BlePreset}"
                                              DisplayMemberPath="Title" Margin="0,0,8,0" IsEnabled="{Binding CanConfigureWin10Stack}"
                                              ToolTip="固定 7.5ms 优先；其他两组用于兼容尝试"/>
                                    <Button x:Name="Win10BleConfigureButton" Content="授权并测试" Click="ConfigureBleTurbo_Click" Margin="0,0,8,0" Padding="14,7"
                                            IsEnabled="{Binding CanConfigureWin10Stack}" ToolTip="{Binding Win10BlePresetSafetyNote}"/>
                                    <Button x:Name="BleRestoreParametersButton" Content="恢复原参数" Click="RestoreBleTurbo_Click" Margin="0" Padding="14,7"/>
                                </WrapPanel>
                                <TextBlock Text="效果以真实输入为准；未提速时，可换预设或恢复原参数。" Style="{StaticResource MutedText}" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                        </StackPanel>
                        <TextBlock Grid.Row="2" Text="{Binding Status}" Style="{StaticResource MutedText}" Margin="0,5,0,8"/>
                </Grid>
            </TabItem>
            <TabItem Header="震动" AutomationProperties.Name="震动">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <DockPanel><TextBlock Text="{Binding RumblePercentText}" DockPanel.Dock="Right" FontWeight="SemiBold"/><TextBlock Text="震动强度" FontSize="23" FontWeight="SemiBold"/></DockPanel>
                                <Slider Minimum="0" Maximum="300" TickFrequency="10" IsSnapToTickEnabled="True"
                                        Value="{Binding RumblePercent}" Margin="0,18,0,10" AutomationProperties.Name="震动强度"/>
                                <TextBlock Text="当前反馈" Style="{StaticResource MutedText}" Margin="0,16,0,0"/>
                                <TextBlock Text="{Binding CompactHapticSource}" FontSize="15" Margin="0,7,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="背键 / C 键" AutomationProperties.Name="背键与 C 键设置">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,16">
                        <DockPanel>
                            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                <Button Content="停止动作" Command="{Binding CancelRearButtonsCommand}" Margin="12,0,0,0" ToolTip="停止背键与 C 键动作；松开后重新按下可再次使用"/>
                                <Button Content="重置" Command="{Binding ResetRearButtonsCommand}" Margin="12,0,8,0"/>
                                <Button Content="保存并应用" Style="{StaticResource Primary}" Command="{Binding ApplyRearButtonsCommand}" IsEnabled="{Binding CanOperate}" Margin="0" ToolTip="只保存当前配置；修改正在使用的映射会取消当前背键动作"/>
                            </StackPanel>
                            <ComboBox ItemsSource="{Binding RearModes}" SelectedItem="{Binding RearEditingMode}"
                                      DockPanel.Dock="Right" Width="130" Margin="12,0,0,0" AutomationProperties.Name="背键配置模式" ToolTip="选择要编辑的配置；不会切换正在使用的手柄模式"/>
                            <TextBlock Text="背键 / C 键" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DockPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{Binding RearDraftStatus}" Style="{StaticResource MutedText}" Margin="0,0,16,0"/>
                            <TextBlock Text="{Binding RearSettingsStatus}" Foreground="#183D31"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <ScrollViewer x:Name="RearSelectorsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="选择按键" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                            <ItemsControl x:Name="RearKeyList" ItemsSource="{Binding RearEditors}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Button Command="{Binding DataContext.SelectRearButtonCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="14,18" Margin="0,0,0,10">
                                        <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                            <Style.Triggers><DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter Property="Background" Value="#EAF2EC"/><Setter Property="BorderBrush" Value="#699980"/></DataTrigger></Style.Triggers>
                                        </Style></Button.Style>
                                    <StackPanel>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding MappingSummary}" Style="{StaticResource MutedText}" Margin="0,8,0,6"/>
                                    <TextBlock Text="{Binding EnabledCaption}" Style="{StaticResource MutedText}"/>
                                    </StackPanel></Button>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="无需连接即可配置" Style="{StaticResource MutedText}" Margin="4,6,0,0"/>
                        </StackPanel>
                        </ScrollViewer>
                        <ScrollViewer x:Name="RearEditorScroll" Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl Content="{Binding SelectedRearEditor}" HorizontalContentAlignment="Stretch" Margin="0,0,4,0"/>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="设置" AutomationProperties.Name="设置">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,4,0">
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <TextBlock Text="USBIP" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding UsbipLocationText}" Style="{StaticResource MutedText}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RuntimeReadinessText}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                <WrapPanel IsEnabled="{Binding CanManageRuntime}">
                                    <Button x:Name="SelectUsbipPathButton" Content="选择 usbip.exe…" Click="SelectUsbipPath_Click"/>
                                    <Button x:Name="ResetUsbipPathButton" Content="自动查找" Command="{Binding ResetUsbipPathCommand}"/>
                                    <Button Content="安装 / 修复驱动" Command="{Binding InstallUsbipCommand}"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,12">
                                    <Button x:Name="SettingsEnvironmentInfoButton" Content="系统与蓝牙信息…" Click="EnvironmentInfo_Click" DockPanel.Dock="Right" Padding="12,6" Margin="0"/>
                                    <TextBlock Text="设置" FontSize="23" FontWeight="SemiBold"/>
                                </DockPanel>
                                <WrapPanel>
                                    <CheckBox Content="登录 Windows 时自动启动" IsChecked="{Binding LaunchAtLoginEnabled}" Margin="0,0,28,12"/>
                                    <CheckBox Content="启动后自动进入上次使用的模式" IsChecked="{Binding AutoReconnectOnStartupEnabled}"/>
                                </WrapPanel>
                                <WrapPanel>
                                    <CheckBox Content="每10分钟更新电量" IsChecked="{Binding RuntimeBatteryRefreshEnabled}"
                                              Margin="0,0,28,0" ToolTip="输入稳定时读取原生档位；异常时自动暂停更新，保留上次读取值。"/>
                                    <CheckBox x:Name="AutoOptimizeBleCheckBox" Content="低速时自动优化蓝牙" IsChecked="{Binding AutoOptimizeBle}" IsEnabled="{Binding CanChangeBleOptimizationSettings}"
                                              ToolTip="Win11 在当前连接内自动尝试有限预设，跨适配器型号和驱动版本开放；Win10 全局参数必须单独确认和管理员授权，不会静默轮换。"/>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="16">
                            <StackPanel IsEnabled="{Binding CanOperate}">
                                <TextBlock Text="校准与连接" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <Button Content="摇杆零位校准" Command="{Binding CalibrateStickCenterSlotCommand}" CommandParameter="1"/>
                                    <Button Content="摇杆行程校准" Command="{Binding CalibrateStickRangeSlotCommand}" CommandParameter="1"/>
                                    <Button Content="陀螺仪校准" Command="{Binding CalibrateSourceGyroCommand}"/>
                                    <Button Content="断开真实手柄" Command="{Binding DisconnectPro2InputCommand}"/>
                                    <Button x:Name="RestartBluetoothAdapterButton" Content="重启蓝牙适配器…" Click="RestartBluetooth_Click"
                                            ToolTip="需要管理员授权；所选适配器的蓝牙连接会暂时断开，不改驱动或配对。"/>
                                </WrapPanel>
                                <TextBlock Text="零位：松开摇杆2秒 · 行程：沿外圈转动8秒 · 陀螺仪：静置3秒" Style="{StaticResource MutedText}"/>
                                <TextBlock Text="{Binding BluetoothRestartStatus}" TextWrapping="Wrap" Style="{StaticResource MutedText}" Margin="0,8,0,0"
                                           Visibility="{Binding HasBluetoothRestartStatus, Converter={StaticResource BoolVisibility}}"/>
                                <Expander Header="更多手柄 · Steam / Xbox" Margin="0,16,0,0">
                                    <ItemsControl ItemsSource="{Binding Pro2Slots}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <StackPanel Margin="0,12,0,8">
                                                <DockPanel>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Enabled}" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                                                    <TextBlock Text="{Binding Status}" Style="{StaticResource MutedText}"/>
                                                </DockPanel>
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Button Content="连接" Command="{Binding DataContext.ConnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                    <Button Content="断开" Command="{Binding DataContext.DisconnectPro2SlotCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Index}"/>
                                                </WrapPanel>
                                            </StackPanel>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Expander>
                            </StackPanel>
                        </Border>
                        <Expander Header="高级设置与诊断" IsExpanded="{Binding ShowDiagnostics}" Padding="0,4">
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,12,0,12">
                                    <StackPanel>
                                        <TextBlock Text="连接信息" FontWeight="SemiBold" FontSize="17" Margin="0,0,0,14"/>
                                        <TextBlock Text="{Binding CompatibilityTitle}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding CompatibilityGuidance}" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,12"/>
                                        <TextBlock Text="最小化后仍在托盘运行；窗口刷新不会影响手柄输入。" Style="{StaticResource MutedText}" Margin="0,0,0,12"/>
                                        <TextBlock Text="{Binding CompactActualMode}"/>
                                        <TextBlock Text="{Binding InputStatus}" Style="{StaticResource MutedText}" Margin="0,8,0,8"/>
                                        <WrapPanel>
                                            <TextBlock Text="Raw: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactRawRate}" Margin="0,0,20,0"/>
                                            <TextBlock Text="Parsed: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactParsedRate}" Margin="0,0,20,0"/>
                                            <TextBlock Text="最新输入年龄: " Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding CompactInputAge}"/>
                                        </WrapPanel>
                                        <TextBlock Text="摇杆处理" Margin="0,18,0,0"/>
                                        <ComboBox ItemsSource="{Binding StickProcessingChoices}" SelectedItem="{Binding SelectedStickProcessing}" IsEnabled="{Binding CanOperate}"/>
                                        <TextBlock Text="PS5 陀螺仪倍率"/>
                                        <Slider Minimum="0.1" Maximum="3" Value="{Binding Ps5GyroScale}" Margin="0,12,0,8"/>
                                        <TextBlock Text="{Binding Ps5GyroScaleText}" Style="{StaticResource MutedText}"/>
                                        <WrapPanel IsEnabled="{Binding CanOperate}">
                                            <Button Content="导出诊断包" Command="{Binding ExportDiagnosticsLogCommand}"/>
                                            <Button Content="BLE 实测 15 秒" Command="{Binding RunWin10BleDiagnosticCommand}"/>
                                            <Button Content="清理残留虚拟设备" Command="{Binding CleanupStaleVirtualDevicesCommand}"/>
                                            <Button Content="修复 USBIP 驱动" Command="{Binding InstallUsbipCommand}"/>
                                            <Button Content="刷新 Steam 缓存" Click="RefreshSteamControllerCache_Click"/>
                                        </WrapPanel>
                                        <TextBlock Text="BLE 初始化对照" FontWeight="SemiBold" Margin="0,14,0,6"/>
                                        <CheckBox Content="同时跳过 USB 初始化（对照测试）" IsChecked="{Binding SkipUsbBleInitialization}"/>
                                        <TextBlock Text="默认已跳过配对提交。此开关仅影响下一次连接，不自动断开；本次程序关闭后复位。" Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <DockPanel><Button Content="清空显示" DockPanel.Dock="Right" Command="{Binding ClearLogCommand}"/><TextBlock Text="会话日志" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
                                        <TextBox Text="{Binding LogText, Mode=OneWay}" IsReadOnly="True" Height="180" FontFamily="Consolas" FontSize="11"
                                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#F5F7F6" BorderThickness="0" Padding="12"/>
                                        <TextBlock Text="界面日志每秒最多刷新一次；文件日志在后台异步保存。" Style="{StaticResource MutedText}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2" Margin="0,18,0,0">
            <Button x:Name="FooterEnvironmentInfoButton" DockPanel.Dock="Right" Click="EnvironmentInfo_Click" Padding="5,2" Margin="0"
                    Background="Transparent" BorderBrush="Transparent" FontSize="12" Foreground="{StaticResource Muted}"
                    ToolTip="点击查看系统版本、蓝牙适配器、驱动和当前输入状态">
                <TextBlock Text="{Binding CompactSystemText}"/>
            </Button>
            <TextBlock Text="纯软件 · 无需外置接收器" Style="{StaticResource MutedText}"/>
        </DockPanel>
    </Grid>
</Window>
