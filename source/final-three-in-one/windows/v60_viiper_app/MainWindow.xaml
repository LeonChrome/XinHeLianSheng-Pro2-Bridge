<Window x:Class="Y700Switch2V60Viiper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore"
        Title="PRO2 手柄无线接收器控制板 V6.2.32 Test r2 · 四人三模大厅"
        Icon="Assets/AppIcon.ico"
        Width="1440"
        Height="940"
        MinWidth="1160"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#050713"
        FontFamily="Microsoft YaHei UI"
        Foreground="#F8FAFC"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <LinearGradientBrush x:Key="WindowBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#050713" Offset="0"/>
            <GradientStop Color="#10142A" Offset="0.5"/>
            <GradientStop Color="#080A16" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="ConsoleBackground" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#E60A1020" Offset="0"/>
            <GradientStop Color="#E612172A" Offset="1"/>
        </LinearGradientBrush>

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#7783A7"/>
        </Style>

        <Style x:Key="HeroButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#F8FAFC"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeroCard" TargetType="Border">
            <Setter Property="CornerRadius" Value="26"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#33415F"/>
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="8" Opacity="0.35" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.96"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeroImage" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.62"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1"/>
                        <TranslateTransform Y="0"/>
                    </TransformGroup>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.22"
                                             To="1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                            <DoubleAnimation Duration="0:0:0.22"
                                             To="1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                            <DoubleAnimation Duration="0:0:0.22"
                                             To="0"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Duration="0:0:0.28"
                                             To="1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)"/>
                            <DoubleAnimation Duration="0:0:0.28"
                                             To="1"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)"/>
                            <DoubleAnimation Duration="0:0:0.28"
                                             To="0"
                                             Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ConsoleButton" TargetType="Button">
            <Setter Property="Foreground" Value="#EAF2FF"/>
            <Setter Property="Background" Value="#1C2643"/>
            <Setter Property="BorderBrush" Value="#425071"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="MinWidth" Value="116"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#2A385E"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A80B8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.38"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkTextBox" TargetType="TextBox">
            <Setter Property="Foreground" Value="#E6EEFF"/>
            <Setter Property="Background" Value="#0A0F20"/>
            <Setter Property="BorderBrush" Value="#33415F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#58E1FF"/>
        </Style>

        <Style x:Key="DarkComboBoxItem" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#E6EEFF"/>
            <Setter Property="Background" Value="#10172A"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemChrome"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#243452"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemChrome" Property="Background" Value="#175B78"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DarkComboBox" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#E6EEFF"/>
            <Setter Property="Background" Value="#0A0F20"/>
            <Setter Property="BorderBrush" Value="#33415F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="TextElement.Foreground" Value="#E6EEFF"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource DarkComboBoxItem}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="Chrome"
                                    Grid.ColumnSpan="2"
                                    CornerRadius="8"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"/>
                            <ContentPresenter x:Name="ContentSite"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                            <Path HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  Margin="0,0,11,0"
                                  Fill="#B9C8E8"
                                  Data="M 0 0 L 5 5 L 10 0 Z"/>
                            <ToggleButton Focusable="False"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Opacity="0"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   PopupAnimation="Fade">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                        CornerRadius="9"
                                        Background="#10172A"
                                        BorderBrush="#405071"
                                        BorderThickness="1">
                                    <ScrollViewer Margin="0"
                                                  SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#6A80B8"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#58E1FF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AxisCheckBox" TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D9ECFF"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    CornerRadius="4"
                                    Background="#0A0F20"
                                    BorderBrush="#52678F"
                                    BorderThickness="1"/>
                            <Border x:Name="Dot"
                                    Width="8"
                                    Height="8"
                                    CornerRadius="4"
                                    Background="#58E1FF"
                                    Visibility="Collapsed"/>
                            <ContentPresenter Grid.Column="1"
                                              Margin="6,0,0,0"
                                              VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#58E1FF"/>
                                <Setter TargetName="Box" Property="Background" Value="#123B52"/>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="#9DEEFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.46"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="#EDF4FF"/>
            <Setter Property="Background" Value="#F0121829"/>
            <Setter Property="BorderBrush" Value="#516181"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,7"/>
        </Style>

        <Style x:Key="EnterButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="30,17"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Glow"
                                    CornerRadius="18"
                                    Background="#7A00D7FF"
                                    Opacity="0.36"
                                    Margin="-5">
                                <Border.Effect>
                                    <BlurEffect Radius="18"/>
                                </Border.Effect>
                            </Border>
                            <Border x:Name="ButtonSurface"
                                    CornerRadius="15"
                                    BorderThickness="1"
                                    BorderBrush="#9DEEFF">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#007AA8" Offset="0"/>
                                        <GradientStop Color="#6D28D9" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Glow" Property="Opacity" Value="0.72"/>
                                <Setter TargetName="ButtonSurface" Property="BorderBrush" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.72"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonSurface" Property="Opacity" Value="0.42"/>
                                <Setter TargetName="Glow" Property="Opacity" Value="0.12"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBackground}">
        <Ellipse Width="720" Height="720" HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-360,-380,0,0" Fill="#27195AD6" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="120"/>
            </Ellipse.Effect>
        </Ellipse>
        <Ellipse Width="680" Height="680" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-360,-410" Fill="#2435C8D4" IsHitTestVisible="False">
            <Ellipse.Effect>
                <BlurEffect Radius="130"/>
            </Ellipse.Effect>
        </Ellipse>

        <ScrollViewer VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="30,22,30,28" MaxWidth="1500" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="VIIPER ARENA · WINDOWS EXCLUSIVE"/>
                        <TextBlock Margin="0,5,0,0" FontSize="30" FontWeight="Black" Text="选择你的无线身份"/>
                        <TextBlock Margin="0,5,0,0" Foreground="#9AA8C7" FontSize="13"
                                   Text="点击角色即可部署或直接切换模式。连接真实 Pro2 BLE 后，当前角色将从 neutral 切换为 live 输入。"/>
                        <Border Margin="0,12,0,0" Padding="12,9" CornerRadius="10"
                                Background="#18243C" BorderBrush="#3A527B" BorderThickness="1">
                            <TextBlock Foreground="#BDD5FF" FontSize="12" FontWeight="SemiBold"
                                       Text="{Binding RuntimeReadinessText}" TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <Border Background="#1BFFFFFF" BorderBrush="#3AFFFFFF" BorderThickness="1"
                                CornerRadius="14" Padding="14,9">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="#5EF2A5" Margin="0,0,8,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#5EF2A5" BlurRadius="12" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock FontWeight="Bold" Foreground="#C9FCE0" Text="V6.2.32 Test r2 · 双摇杆校准"/>
                            </StackPanel>
                        </Border>
                        <Button Margin="0,9,0,0" HorizontalAlignment="Right"
                                Style="{StaticResource ConsoleButton}"
                                Content="停止当前角色"
                                automation:AutomationProperties.Name="停止虚拟设备"
                                Command="{Binding StopCommand}"
                                IsEnabled="{Binding CanStop}"/>
                        <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="12"
                                Background="#151F36" BorderBrush="#2F4266" BorderThickness="1">
                            <StackPanel>
                                <CheckBox Style="{StaticResource AxisCheckBox}"
                                          Content="开机自启动"
                                          IsChecked="{Binding LaunchAtLoginEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <CheckBox Margin="0,7,0,0"
                                          Style="{StaticResource AxisCheckBox}"
                                          Content="启动后自动进入上次模式"
                                          IsChecked="{Binding AutoReconnectOnStartupEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Margin="0,7,0,0" Foreground="#7F90B0" FontSize="10"
                                           TextWrapping="Wrap" Width="220"
                                           Text="{Binding StartupAutomationSummary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="1" Margin="0,24,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionLabel}" Text="CHARACTER SELECT"/>
                        <TextBlock Margin="0,4,0,0" FontSize="16" FontWeight="Bold" Text="{Binding ModeHeadline}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock HorizontalAlignment="Right" FontSize="12" Foreground="#8390AE"
                                   Text="{Binding SelectedHeroName}"/>
                        <TextBlock HorizontalAlignment="Right" Margin="0,3,0,0" FontSize="11"
                                   Foreground="#5EE7FF" Text="{Binding SelectedModeSubtitle}"/>
                    </StackPanel>
                </Grid>

                <Grid Grid.Row="2" Height="485">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource HeroButton}"
                            Command="{Binding StartDualSenseCommand}"
                            IsEnabled="{Binding CanOperate}"
                            automation:AutomationProperties.Name="启动 新和联胜 / PS5"
                            ToolTip="部署新和联胜 / PS5 模式">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource HeroCard}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#561D0C18" Offset="0"/>
                                                <GradientStop Color="#DD160A14" Offset="0.58"/>
                                                <GradientStop Color="#F2070A12" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDualSenseSelected}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#FF5B49"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#FF321F" BlurRadius="34" ShadowDepth="0" Opacity="0.55"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Ellipse Width="300" Height="300" VerticalAlignment="Center" Fill="#24FF3C28">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualSenseSelected}" Value="True">
                                                    <Setter Property="Opacity" Value="0.42"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="54"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Margin="20,16" HorizontalAlignment="Left" VerticalAlignment="Top"
                                           FontSize="11" FontWeight="Bold" Foreground="#FF8A7C" Text="01 · GOD OF WAR"/>
                                <Border Margin="0,14,16,0" Padding="9,5" HorizontalAlignment="Right"
                                        VerticalAlignment="Top" CornerRadius="10" Background="#C9FF3B30">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Opacity" Value="0"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDualSenseActive}" Value="True">
                                                    <Setter Property="Opacity" Value="1"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock FontSize="10" FontWeight="Black" Text="LIVE"/>
                                </Border>
                                <Image Grid.Row="0" Margin="42,34,42,-8" Style="{StaticResource HeroImage}"
                                       Source="/Assets/Characters/kratos.png"/>
                                <Border Grid.Row="1" Background="#D90B0D16" Padding="20,15" CornerRadius="0,0,24,24">
                                    <StackPanel>
                                        <TextBlock FontSize="22" FontWeight="Black" Text="新和联胜"/>
                                        <TextBlock Margin="0,2,0,0" FontSize="12" FontWeight="Bold" Foreground="#FF7365"
                                                   Text="PS5 · DUALSENSE"/>
                                        <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="#AEB7CC"
                                                   Text="4CH HD 音频 + 普通震动调度 · 054C:0CE6"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Button>

                    <Button Grid.Column="1"
                            Style="{StaticResource HeroButton}"
                            Command="{Binding StartPro2Command}"
                            IsEnabled="{Binding CanOperate}"
                            automation:AutomationProperties.Name="启动 Pro2 / Nintendo"
                            ToolTip="部署 Pro2 / Nintendo 模式">
                        <Border>
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource HeroCard}">
                                    <Setter Property="Background">
                                        <Setter.Value>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#402E0A18" Offset="0"/>
                                                <GradientStop Color="#C1091730" Offset="0.58"/>
                                                <GradientStop Color="#F2070A16" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPro2Selected}" Value="True">
                                            <Setter Property="Opacity" Value="1"/>
                                            <Setter Property="BorderBrush" Value="#43A7FF"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="RenderTransform">
                                                <Setter.Value>
                                                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect Color="#167DFF" BlurRadius="34" ShadowDepth="0" Opacity="0.58"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
