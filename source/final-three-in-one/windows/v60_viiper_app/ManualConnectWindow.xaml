<Window x:Class="Y700Switch2V60Viiper.ManualConnectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="手动连接 Pro2" Width="800" Height="600" MinWidth="480" MinHeight="360"
        WindowStartupLocation="CenterOwner" Background="#F5F7F6" Foreground="#192824"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14" UseLayoutRounding="True">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="16,10"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DFE7E2"/>
            <Setter Property="Foreground" Value="#253C32"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="Background" Value="#EAF2EC"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#183D31"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <Button Content="重新扫描" Click="Refresh_Click" DockPanel.Dock="Right"/>
            <StackPanel><TextBlock Text="手动连接" FontWeight="SemiBold" FontSize="24"/>
                <TextBlock Text="{Binding ActivityText}" Foreground="#667870" Margin="0,6,0,0"/>
            </StackPanel>
        </DockPanel>
        <TextBlock Grid.Row="1" Text="BLE 广播地址 · 优先显示最可能的 Pro2 · 点击地址尝试连接" Foreground="#667870" FontSize="12" Margin="0,18,0,12" TextWrapping="Wrap"/>
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,0,4,0">
                <ItemsControl.ItemTemplate><DataTemplate>
                    <Button Tag="{Binding}" Click="Candidate_Click" HorizontalContentAlignment="Stretch" Padding="16,14" Margin="0,0,0,8" AutomationProperties.Name="{Binding AddressText}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Confidence}" Foreground="#315847"/>
                            <TextBlock Grid.Column="2" Text="{Binding Signal}" Foreground="#667870" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Row="1" Text="{Binding AddressDetail}" Foreground="#667870" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12" Margin="0,8,10,0" TextWrapping="Wrap"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Evidence}" Foreground="#667870" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </Grid>
                    </Button>
                </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,16,0" VerticalAlignment="Center" Foreground="#315847"/>
            <Button Grid.Column="1" Content="返回" Click="Return_Click" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</Window>
