<Window x:Class="Y700Switch2V60Viiper.PhysicalInputsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="实体输入与 NFC" Width="860" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F8F6" Foreground="#253C32">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,6"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#CCD9D1"/></Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="实体输入" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="先选实体手柄和槽位；输出模式在首页或多手柄窗口切换。" Foreground="#667870" Margin="0,7,0,14"/>
            <WrapPanel>
                <TextBlock Text="手柄槽位" VerticalAlignment="Center" Margin="0,0,10,6"/>
                <ComboBox x:Name="SlotChoice" Width="110" SelectedIndex="0" SelectionChanged="Slot_Changed" Margin="0,0,20,6">
                    <ComboBoxItem Content="手柄 1"/><ComboBoxItem Content="手柄 2"/><ComboBoxItem Content="手柄 3"/><ComboBoxItem Content="手柄 4"/>
                </ComboBox>
                <Button x:Name="RefreshButton" Content="刷新列表" Click="Refresh_Click"/>
                <Button Content="Windows 蓝牙配对" Click="Pairing_Click"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Pro1 蓝牙：先在 Windows 配对 Pro Controller。USB：使用数据线连接。列表排除本程序创建的虚拟手柄。" Foreground="#667870" Margin="0,6,0,12"/>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <ListBox x:Name="Devices" BorderBrush="#CCD9D1" SelectionChanged="Device_Changed" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="Wrap" MaxWidth="320" Margin="4,7"/></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" Margin="0,12,0,0">
                    <WrapPanel>
                        <Button x:Name="ConnectButton" Content="接入所选手柄" Click="Connect_Click" IsEnabled="False"/>
                        <Button x:Name="DisconnectButton" Content="断开此槽位" Click="Disconnect_Click"/>
                    </WrapPanel>
                    <Button x:Name="BleButton" Content="此槽位改用 Pro2 BLE" Click="Ble_Click" HorizontalAlignment="Left"/>
                    <TextBlock Text="Pro1 按真实输入频率转发；不保证 250Hz。Pro2 USB 目标 250Hz，以实测为准。当前手柄支持哪些按键、陀螺仪与 NFC，由实体型号和连接方式决定。" Foreground="#667870" FontSize="12" Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <TextBlock Text="NFC / amiibo" FontSize="18" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Pro1 蓝牙只读：将标签贴近手柄 NFC 区。读取时暂停此槽位的游戏输入和震动，结束后恢复。导出的原始文件可供支持它的模拟器载入；不会自动把 NFC 转发到游戏或主机。" Foreground="#667870" Margin="0,8,0,12"/>
                <WrapPanel Grid.Row="2">
                    <Button x:Name="NfcButton" Content="读取标签（25秒）" Click="ReadNfc_Click"/>
                    <Button x:Name="CancelNfcButton" Content="取消" Click="CancelNfc_Click" IsEnabled="False"/>
                    <Button x:Name="SaveNfcButton" Content="保存 .bin…" Click="SaveNfc_Click" IsEnabled="False"/>
                </WrapPanel>
                <TextBox Grid.Row="3" x:Name="Evidence" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" BorderBrush="#CCD9D1" Padding="10" Margin="0,8,0,0" FontFamily="Consolas, Microsoft YaHei UI" FontSize="12"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,16,0,0" Foreground="#667870"/>
    </Grid>
</Window>
