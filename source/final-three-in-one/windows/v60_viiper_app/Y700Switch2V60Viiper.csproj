    <Resource Include="Assets\Characters\master-chief.png" />
    <EmbeddedResource Include="..\..\tools\viiper\haptic-v0.8.0\viiper-haptic.exe" LogicalName="Embedded.viiper.haptic.exe" />
    <EmbeddedResource Include="..\..\tools\viiper\haptic-v0.8.0\LICENSE.txt" LogicalName="Embedded.viiper.haptic.license" />
    <EmbeddedResource Include="..\..\tools\usbip-win2\v0.9.7.7\USBip-0.9.7.7-x64.exe" LogicalName="Embedded.usbip.installer" />
    <EmbeddedResource Include="..\..\tools\usbip-win2\v0.9.7.7\LICENSE.txt" LogicalName="Embedded.usbip.license" />
  </ItemGroup>
</Project>


